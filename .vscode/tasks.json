{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests with Coverage",
      "type": "shell",
      "command": "pytest --cov=weather_cli --cov-report=html --cov-report=term",
      "problemMatcher": []
    },
    {
      "label": "Format Code",
      "type": "shell",
      "command": "black weather_cli tests && isort weather_cli tests",
      "problemMatcher": []
    },
    {
      "label": "Lint Code",
      "type": "shell",
      "command": "flake8 weather_cli tests && mypy weather_cli",
      "problemMatcher": []
    },
    {
      "label": "Build Docker Image",
      "type": "shell",
      "command": "docker build -t weather-cli:latest .",
      "problemMatcher": []
    },
    {
      "label": "Run Weather CLI (London)",
      "type": "shell",
      "command": "python -m weather_cli.cli London",
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    }
  ]
}
